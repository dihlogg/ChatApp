<Window x:Class="ChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp"
        xmlns:viewmodel="clr-namespace:ChatClient.MVVM.ViewModel"
        xmlns:local1="clr-namespace:ChatClient.MVVM.Core"
        mc:Ignorable="d"
        Title="Chat App" Height="471" Width="816">

    <Window.Resources>
        <local1:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter"/>
        <local1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local1:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter"/>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <viewmodel:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Left Panel for Users -->
        <DockPanel>
            <TextBox Height="25"
                     DockPanel.Dock="Top"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <Button Height="25"
                     DockPanel.Dock="Top"
                     Content="Connect To Server"
                     Command="{Binding ConnectToServerCommand}" />
            <ListView ItemsSource="{Binding Users}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="LightGray" Margin="5" Padding="5" CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Width="165">
                                <!-- Circular Image -->
                                <Ellipse Width="50" Height="50" Margin="5">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding Username}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- Right Panel for Messages -->
        <StackPanel Grid.Column="1">
            <ListView Height="380" ItemsSource="{Binding Messages}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sent Message -->
                            <Border Margin="5"
                        Padding="10"
                        CornerRadius="15"
                        Background="{Binding IsSentByMe, Converter={StaticResource BoolToBackgroundConverter}}"
                        HorizontalAlignment="{Binding IsSentByMe, Converter={StaticResource BoolToHorizontalAlignmentConverter}}"
                        MaxWidth="300">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="LightBlue" />
                                </Border.BorderBrush>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Received Message -->
                            <Border Margin="5"
                        Padding="10"
                        CornerRadius="15"
                        Background="LightBlue"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsSentByMe, Converter={StaticResource BoolToVisibilityConverter}}"
                        MaxWidth="300">
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


            <!-- Input Box and Send Button -->
            <StackPanel Orientation="Horizontal">
                <TextBox Height="55"
                         Width="490"
                         VerticalContentAlignment="Center"
                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         KeyDown="TextBox_KeyDown"/>

                <Button Width="55"
                    x:Name="UploadButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="UploadButton_Click">
                    <Button.Content>
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                            Fill="#0052FE"
                            Width="24"
                            Height="24"/>
                    </Button.Content>
                </Button>

                <Button Width="55"
                    Command="{Binding SendMessageCommand}"
                    Style="{StaticResource IconButtonStyle}">
                    <Button.Content>
                        <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                            Fill="#0052FE"
                            Width="24"
                            Height="24"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>