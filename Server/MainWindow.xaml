<Window x:Class="Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server"
        xmlns:local1="clr-namespace:Server.MVVM.Core"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- User list panel -->
            <ColumnDefinition Width="*"/>
            <!-- Chat panel -->
        </Grid.ColumnDefinitions>

        <!-- User List Panel -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Connected Users" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- User List -->
            <ListBox Name="UserListBox" Grid.Row="1" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Username}" VerticalAlignment="Center"/>
                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Text="{Binding IPAddress}" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>


            <!-- Server Status -->
            <Button x:Name="StartButton" Grid.Row="2" Content="Start Server"
                Height="35" Click="StartButton_Click"/>
        </Grid>

        <!-- Chat Panel -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chat Header -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Chat Messages" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Chat Messages -->
            <TextBox x:Name="ChatLogTextBox" Grid.Row="1"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"
         IsReadOnly="True"
         Background="#F5F5F5"
         Padding="10"/>
        </Grid>
    </Grid>
</Window>